# LeadRadar 密钥配置（复制为 .env 后填写，config.json 里留空时从这里读取）

# 搜索 API 三选一
SERPER_API_KEY=
BING_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# 大模型（AI 判断 + 自动写开发信；OpenAI 兼容接口，DeepSeek/通义/智谱/Kimi 都行）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# 邮箱查找 API（可选）
HUNTER_API_KEY=
APOLLO_API_KEY=
SNOV_USER_ID=
SNOV_SECRET=

# 可覆盖 Chrome 路径（无头抓取备用）
CHROME_PATH=

# 代理（访问 Instagram/TikTok 等海外站点用；填本地代理地址，如 Clash 默认 7890）
HTTPS_PROXY=http://127.0.0.1:7890
